{
  "name": "pluto",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "format:js": "biome format --write ./",
    "format:py": "uvx ruff format packages/analytics",
    "format": "pnpm run format:js && pnpm run format:py"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "download"
    }
  },
  "workspaces": [
    "packages/*"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@swc/core",
      "@tailwindcss/oxide",
      "better-sqlite3",
      "core-js",
      "core-js-pure",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "jwk-to-pem": "link:packages/jwk-to-pem",
      "rimraf": "5.0.5",
      "tmp@<=0.2.3": ">=0.2.4",
      "qs": "6.15.0",
      "tar": "7.5.11",
      "jspdf": "4.2.1",
      "dompurify": "3.4.0",
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "serialize-javascript": "7.0.4",
      "ajv": "8.20.0",
      "axios": "1.15.2",
      "sanitize-html": "2.17.4",
      "@casl/ability": "6.7.5",
      "markdown-it": "14.1.1",
      "koa": "2.16.4",
      "minimatch": "10.2.4",
      "brace-expansion": "5.0.5",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "flatted": "3.4.2",
      "follow-redirects": "1.16.0",
      "handlebars": "4.7.9",
      "path-to-regexp@>=8.0.0 <8.4.0": "8.4.0",
      "postcss": "8.5.13",
      "rollup": "4.59.0",
      "typedoc": "0.28.19",
      "typedoc-github-wiki-theme": "2.1.0",
      "typedoc-plugin-markdown": "4.11.0",
      "undici": "7.25.0",
      "uuid": "14.0.0",
      "vite": "6.4.2",
      "yaml@<2": "1.10.3",
      "zod@<4": "3.25.76"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2024-1899"
      ]
    }
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
